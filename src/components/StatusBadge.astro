---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

/**
 * Znacznik statusu biegu albo wyniku osoby. Status jest komunikowany tekstem ORAZ ikoną,
 * a nie samym kolorem (WCAG 1.4.1).
 */
export type RunStatus = 'completed' | 'planned' | 'unplanned' | 'withdrawn';
/** Wynik osoby w biegu (pole `outcome`): ukończył / nie ukończył (DNF) / nie wystartował (DNS). */
export type ResultOutcome = 'finished' | 'dnf' | 'dns';
export type BadgeStatus = RunStatus | ResultOutcome;

interface Props {
  status: BadgeStatus;
}

const { status } = Astro.props;

const completedClasses =
  'bg-status-completed-bg text-status-completed-fg border-status-completed-fg';

const variants: Record<
  BadgeStatus,
  { label: string; icon: IconName; classes: string }
> = {
  completed: {
    label: 'Ukończony',
    icon: 'check-circle',
    classes: completedClasses,
  },
  finished: {
    label: 'Ukończył',
    icon: 'check-circle',
    classes: completedClasses,
  },
  planned: {
    label: 'Zaplanowany',
    icon: 'calendar',
    classes:
      'bg-status-planned-bg text-status-planned-fg border-status-planned-fg',
  },
  unplanned: {
    label: 'Do ustalenia',
    icon: 'circle-dashed',
    classes:
      'bg-status-unplanned-bg text-status-unplanned-fg border-status-unplanned-fg border-dashed',
  },
  withdrawn: {
    label: 'Poza listą Korony 4.0',
    icon: 'ban',
    classes:
      'bg-status-withdrawn-bg text-status-withdrawn-fg border-status-withdrawn-fg',
  },
  dnf: {
    label: 'Nie ukończył (DNF)',
    icon: 'circle-x',
    classes: 'bg-status-dnf-bg text-status-dnf-fg border-status-dnf-fg',
  },
  dns: {
    label: 'Nie wystartował (DNS)',
    icon: 'circle-minus',
    classes: 'bg-status-dns-bg text-status-dns-fg border-status-dns-fg',
  },
};

const { label, icon, classes } = variants[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-pill border px-2.5 py-0.5 text-sm font-semibold whitespace-nowrap',
    classes,
  ]}
  data-status={status}
>
  <Icon name={icon} class="size-4 shrink-0" />
  {label}
</span>
