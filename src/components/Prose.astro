---
/** Kontener typograficzny dla treści Markdown wpisu (tokeny z global.css). */
---

<div class="prose-content max-w-prose text-lg">
  <slot />
</div>

<style>
  .prose-content :global(> * + *) {
    margin-top: 1.25rem;
  }
  .prose-content :global(h2),
  .prose-content :global(h3),
  .prose-content :global(h4) {
    margin-top: 2.25rem;
    font-weight: 700;
  }
  .prose-content :global(h2) {
    font-size: 1.5rem;
  }
  .prose-content :global(h3) {
    font-size: 1.25rem;
  }
  .prose-content :global(h4) {
    font-size: 1.125rem;
  }
  .prose-content :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }
  .prose-content :global(a:hover) {
    color: var(--color-brand-strong);
    text-decoration-thickness: 0.15em;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.5rem;
  }
  .prose-content :global(ul) {
    list-style: disc;
  }
  .prose-content :global(ol) {
    list-style: decimal;
  }
  .prose-content :global(li + li) {
    margin-top: 0.5rem;
  }
  .prose-content :global(blockquote) {
    border-left: 4px solid var(--color-brand);
    padding-left: 1rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }
  .prose-content :global(code) {
    background-color: var(--color-sand);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.3em;
    font-size: 0.9em;
  }
  .prose-content :global(pre) {
    background-color: var(--color-sand);
    border-radius: var(--radius-md);
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin-block: 2rem;
  }
  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .prose-content :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .prose-content :global(th),
  .prose-content :global(td) {
    border: 1px solid var(--color-line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose-content :global(th) {
    background-color: var(--color-sand);
  }
</style>
