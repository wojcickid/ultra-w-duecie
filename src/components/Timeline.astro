---
import type { CollectionEntry } from 'astro:content';
import RunTerm from './RunTerm.astro';
import RunVerdict from './RunVerdict.astro';
import StatusBadge from './StatusBadge.astro';
import { getResultSummaries, getRunBadges, getRunTerm } from '../lib/runs';
import { isCompletedTogether } from '../lib/progress';
import type { AuthorRef } from '../lib/run-verdict';

/**
 * Oś czasu biegów: lista nieponumerowana, na telefonie jedna kolumna. Kolejność jak w `runs`.
 * Element: nazwa + znaczniki, informacja „razem?” (RunVerdict), termin i dystans, na końcu
 * wyniki osób (mniejszą czcionką) — tylko gdy bieg nie jest ukończony wspólnie.
 * Nagłówki elementów to h4 (pod h3 bloku w sekcji „Nasza droga”).
 */
interface Props {
  runs: CollectionEntry<'runs'>[];
  authors: AuthorRef[];
}

const { runs, authors } = Astro.props;
const authorIds = authors.map((author) => author.id);
const authorNames = new Map(authors.map((author) => [author.id, author.name]));
---

<ol class="mt-4 space-y-3">
  {runs.map((run) => {
    const { data } = run;
    const term = getRunTerm(data);
    const results = isCompletedTogether(run, authorIds)
      ? []
      : getResultSummaries(data.results, authorNames);
    return (
      <li
        class:list={[
          'rounded-lg border bg-surface p-4',
          data.retired
            ? 'border-dashed border-status-withdrawn-fg'
            : 'border-line',
        ]}
      >
        <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
          <h4 class="min-w-0 text-lg font-semibold">
            <a href={`/biegi/${run.id}`} class="link">
              {data.name}
            </a>
          </h4>
          <div class="flex flex-wrap gap-2">
            {getRunBadges(data).map((status) => (
              <StatusBadge status={status} />
            ))}
          </div>
        </div>
        <div class="mt-2">
          <RunVerdict run={run} authors={authors} />
        </div>
        <p class="mt-2 text-ink-muted">
          {term.kind !== 'tbd' && <span class="sr-only">{term.label}: </span>}
          <RunTerm term={term} />
          {data.distanceKm !== undefined && (
            <>
              <span aria-hidden="true"> · </span>
              <span class="sr-only">Dystans: </span>
              {data.distanceKm.toLocaleString('pl-PL')} km
            </>
          )}
        </p>
        {results.length > 0 && (
          <ul class="mt-1 text-sm text-ink-muted">
            {results.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ol>
