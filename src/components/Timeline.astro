---
import StatusBadge from './StatusBadge.astro';
import type { RunStatus } from './StatusBadge.astro';

/** Oś czasu biegów: lista uporządkowana, na telefonie jedna kolumna. */
export interface TimelineItem {
  id: string;
  name: string;
  /** Znaczniki z `getRunBadges` (jedno źródło prawdy, DEC-008). */
  badges: RunStatus[];
  distance?: string;
  /** Termin z `getRunTerm`: etykieta (np. „Ukończono”) i wartość (data z `isoDate` albo tekst orientacyjny). */
  termLabel: string;
  term: string;
  isoDate?: string;
  /** Krótka adnotacja tekstowa, np. o biegu wycofanym lub ukończeniu wspólnym. */
  note?: string;
  /** Wyniki osób, gdy bieg nie jest ukończony wspólnie (np. „Damian: ukończył 09:49:42”). */
  results?: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="mt-6 space-y-3">
  {items.map((item) => (
    <li
      class:list={[
        'rounded-lg border bg-surface p-4',
        item.badges.includes('withdrawn')
          ? 'border-dashed border-status-withdrawn-fg'
          : 'border-line',
      ]}
    >
      <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
        <h4 class="min-w-0 text-lg font-semibold">
          <a href={`/biegi/${item.id}`} class="link">
            {item.name}
          </a>
        </h4>
        <div class="flex flex-wrap gap-2">
          {item.badges.map((status) => (
            <StatusBadge status={status} />
          ))}
        </div>
      </div>
      <p class="mt-2 text-ink-muted">
        <span class="sr-only">{item.termLabel}: </span>
        {item.isoDate ? (
          <time datetime={item.isoDate}>{item.term}</time>
        ) : (
          item.term
        )}
        {item.distance && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="sr-only">Dystans: </span>
            {item.distance}
          </>
        )}
      </p>
      {item.results && item.results.length > 0 && (
        <ul class="mt-1 text-sm text-ink-muted">
          {item.results.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      )}
      {item.note && <p class="mt-1 text-sm text-ink-muted">{item.note}</p>}
    </li>
  ))}
</ol>
