---
// Rok publikacji serwisu; w stopce zakres „2026–<bieżący rok>” (rok liczony przy budowie strony).
const FIRST_YEAR = 2026;
const currentYear = new Date().getFullYear();
const years =
  currentYear > FIRST_YEAR ? `${FIRST_YEAR}–${currentYear}` : `${FIRST_YEAR}`;
---

<footer class="mt-16 border-t border-line bg-sand">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8 text-sm text-ink-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      <strong class="font-semibold text-ink">Ultra w duecie</strong> — dwóch
      biegaczy w drodze po Koronę Polskich Ultramaratonów.
    </p>
    <p>&copy; {years} Damian i Grzegorz</p>
  </div>
</footer>
