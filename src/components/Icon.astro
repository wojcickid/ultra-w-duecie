---
/**
 * Jeden zestaw ikon: inline SVG, siatka 24x24, styl linii (stroke 2, zaokrąglone końce).
 * Ikony są dekoracyjne (aria-hidden) — znaczenie zawsze niesie sąsiadujący tekst.
 * Nowe ikony dodawaj tutaj, w tym samym stylu.
 */
export type IconName =
  | 'mountain'
  | 'check-circle'
  | 'calendar'
  | 'circle-dashed'
  | 'ban'
  | 'circle-x'
  | 'circle-minus'
  | 'arrow-right';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;

const paths: Record<IconName, string> = {
  mountain: 'm8 3 4 8 5-5 5 15H2L8 3z',
  'check-circle': 'M21.801 10A10 10 0 1 1 17 3.335M9 11l3 3L22 4',
  calendar:
    'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  'circle-dashed':
    'M10.1 2.182a10 10 0 0 1 3.8 0M13.9 21.818a10 10 0 0 1-3.8 0M17.609 3.721a10 10 0 0 1 2.69 2.7M2.182 13.9a10 10 0 0 1 0-3.8M20.279 17.609a10 10 0 0 1-2.7 2.69M21.818 10.1a10 10 0 0 1 0 3.8M3.721 6.391a10 10 0 0 1 2.7-2.69M6.391 20.279a10 10 0 0 1-2.69-2.7',
  ban: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM4.9 4.9l14.2 14.2',
  'circle-x': 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM15 9l-6 6M9 9l6 6',
  'circle-minus': 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8 12h8',
  'arrow-right': 'M5 12h14M12 5l7 7-7 7',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
