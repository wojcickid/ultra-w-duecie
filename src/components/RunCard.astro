---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import RunFacts from './RunFacts.astro';
import RunVerdict from './RunVerdict.astro';
import StatusBadge from './StatusBadge.astro';
import { isCompletedTogether } from '../lib/progress';
import { getResultSummaries, getRunBadges } from '../lib/runs';
import type { AuthorRef } from '../lib/run-verdict';

interface Props {
  run: CollectionEntry<'runs'>;
  /** Autorzy (id + nazwa) do werdyktu „razem?” i zwięzłego opisu wyników osób. */
  authors: AuthorRef[];
  /** Poziom nagłówka nazwy biegu (dopasuj do sekcji, domyślnie 3). */
  headingLevel?: 2 | 3 | 4;
}

const { run, authors, headingLevel = 3 } = Astro.props;
const results = isCompletedTogether(
  run,
  authors.map((author) => author.id),
)
  ? []
  : getResultSummaries(
      run.data.results,
      new Map(authors.map((author) => [author.id, author.name])),
    );
---

<Card
  title={run.data.name}
  headingLevel={headingLevel}
  href={`/biegi/${run.id}`}
>
  <div class="flex flex-wrap gap-2">
    {getRunBadges(run.data).map((status) => (
      <StatusBadge status={status} />
    ))}
  </div>
  <div class="mt-3">
    <RunVerdict run={run} authors={authors} />
  </div>
  <RunFacts run={run.data} class="mt-3 text-sm" />
  {results.length > 0 && (
    <ul class="mt-3 text-sm">
      {results.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  )}
</Card>
