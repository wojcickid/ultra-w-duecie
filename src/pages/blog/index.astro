---
// Strona 1 listy wpisów pod /blog; kolejne strony: src/pages/blog/strona/[page].astro.
import PostsPage from './_PostsPage.astro';
import { getSortedPosts, POSTS_PER_PAGE } from '../../lib/blog';

const posts = await getSortedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<PostsPage
  posts={posts.slice(0, POSTS_PER_PAGE)}
  currentPage={1}
  lastPage={lastPage}
/>
