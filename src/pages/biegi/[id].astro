---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostTeaser from '../../components/PostTeaser.astro';
import RunFacts from '../../components/RunFacts.astro';
import RunResultsTable from '../../components/RunResultsTable.astro';
import Section from '../../components/Section.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getRunBadges, getRunFacts } from '../../lib/runs';
import { getRetiredNote, getTogetherVerdict } from '../../lib/run-verdict';

export const getStaticPaths = (async () => {
  const runs = await getCollection('runs');
  return runs.map((run) => ({ params: { id: run.id }, props: { run } }));
}) satisfies GetStaticPaths;

const { run } = Astro.props;
const { name, location, notes, results } = run.data;

const authors = (await getCollection('authors'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((author) => ({ id: author.id, name: author.data.displayName }));

const verdict = getTogetherVerdict(run, authors);
const together = verdict.kind === 'together';
const retiredNote = getRetiredNote(run, together);

const relatedPosts = (await getCollection('posts'))
  .filter((post) => post.data.run?.id === run.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const summary = [
  name,
  getRunFacts(run.data).find((f) => f.label === 'Dystans')?.value,
  location,
]
  .filter(Boolean)
  .join(', ');
---

<BaseLayout
  title={`${name} — Ultra w duecie`}
  description={`${summary}. Status, wyniki i wpisy o tym biegu Korony Polskich Ultramaratonów.`}
>
  <p>
    <a href="/biegi" class="link">
      Wszystkie biegi
    </a>
  </p>

  <!-- Nagłówek: nazwa, znaczniki, dane biegu -->
  <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{name}</h1>
  <div class="mt-4 flex flex-wrap gap-2">
    {getRunBadges(run.data).map((status) => (
      <StatusBadge status={status} />
    ))}
  </div>

  {retiredNote && (
    <p class="mt-4 max-w-prose rounded-lg border border-line bg-sand p-4 text-ink">
      {retiredNote}
    </p>
  )}

  <RunFacts run={run.data} class="mt-6 max-w-prose text-ink-muted" />

  {notes && <p class="mt-6 max-w-prose text-ink-muted">{notes}</p>}

  <!--
    SEKCJE STRONY BIEGU. Kolejne sekcje (zdjęcia, trasa, GPX, przewyższenie, statystyki, wideo)
    dodaje się tu, jako jeden blok <Section id="..." title="..."> w wybranym miejscu poniżej.
    Nic innego na stronie nie wymaga zmian.
  -->

  <Section id="together" title="Razem">
    <p
      class:list={[
        'mt-4 flex max-w-prose items-start gap-3 rounded-lg border p-4 text-lg',
        together
          ? 'border-status-completed-fg bg-status-completed-bg text-status-completed-fg'
          : 'border-line bg-surface text-ink',
      ]}
    >
      <Icon
        name={
          together
            ? 'check-circle'
            : verdict.kind === 'upcoming'
              ? 'calendar'
              : 'circle-minus'
        }
        class="mt-1 size-5 shrink-0"
      />
      <span class="min-w-0">
        <strong class="font-semibold">{verdict.headline}</strong>
        {verdict.date && (
          <>
            {' — '}
            <time datetime={verdict.isoDate}>{verdict.date}</time>
          </>
        )}
        {verdict.reason && (
          <>
            {' — '}
            {verdict.reason}
          </>
        )}
        {'.'}
      </span>
    </p>
  </Section>

  {results.length > 0 && (
    <Section id="result" title="Nasz wynik">
      <RunResultsTable results={results} authors={authors} runName={name} />
    </Section>
  )}

  {run.data.resultsUrl && (
    <Section id="official-results" title="Oficjalne wyniki">
      <p class="mt-4">
        <a
          href={run.data.resultsUrl}
          class="link inline-flex min-h-11 items-center"
          rel="noopener"
        >
          Wyniki oficjalne tego biegu
        </a>
      </p>
    </Section>
  )}

  <Section id="report" title="Relacja">
    {relatedPosts.length === 0 ? (
      <p class="mt-4 text-ink-muted">
        Relacja z tego biegu jeszcze się nie pojawiła.
      </p>
    ) : (
      <ul class="mt-4 space-y-6">
        {relatedPosts.map((post) => (
          <li>
            <PostTeaser post={post} headingLevel={3} showRun={false} />
          </li>
        ))}
      </ul>
    )}
  </Section>
</BaseLayout>
