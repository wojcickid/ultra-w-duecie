---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { joinNames } from '../../lib/blog';
import { formatDate } from '../../lib/format';
import { getRunBadges, getRunFacts } from '../../lib/runs';

export const getStaticPaths = (async () => {
  const runs = await getCollection('runs');
  return runs.map((run) => ({ params: { id: run.id }, props: { run } }));
}) satisfies GetStaticPaths;

const { run } = Astro.props;
const { name, location, notes } = run.data;

const authorEntries = (await getCollection('authors')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const authors = new Map(authorEntries.map((a) => [a.id, a.data.displayName]));
const authorName = (id: string) => authors.get(id) ?? id;

const results = run.data.results;
// Karta na każdego autora: wynik albo pusty stan „Jeszcze bez wyniku”.
const resultsByAuthor = authorEntries.map((author) => ({
  id: author.id,
  result: results.find((candidate) => candidate.author.id === author.id),
}));

const relatedPosts = (await getCollection('posts'))
  .filter((post) => post.data.run?.id === run.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const facts = getRunFacts(run.data);
const summary = [
  name,
  facts.find((f) => f.label === 'Dystans')?.value,
  location,
]
  .filter(Boolean)
  .join(', ');
---

<BaseLayout
  title={`${name} — Ultra w duecie`}
  description={`${summary}. Status, wyniki i wpisy o tym biegu Korony Polskich Ultramaratonów.`}
>
  <p>
    <a href="/biegi" class="link">
      Wszystkie biegi
    </a>
  </p>

  <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{name}</h1>
  <div class="mt-4 flex flex-wrap gap-2">
    {getRunBadges(run.data).map((status) => (
      <StatusBadge status={status} />
    ))}
  </div>

  {run.data.retired && (
    <p class="mt-4 max-w-prose rounded-lg border border-line bg-sand p-4 text-ink">
      Bieg wycofany z listy stałych biegów Korony.
    </p>
  )}

  {facts.length > 0 && (
    <dl class="mt-6 grid max-w-prose grid-cols-[auto_1fr] gap-x-4 gap-y-2">
      {facts.map(({ label, value }) => (
        <>
          <dt class="font-semibold">{label}</dt>
          <dd class="text-ink-muted">{value}</dd>
        </>
      ))}
    </dl>
  )}

  {notes && <p class="mt-6 max-w-prose text-ink-muted">{notes}</p>}

  <section class="mt-12" aria-labelledby="results-heading">
    <h2 id="results-heading" class="text-2xl font-semibold">
      Wyniki
    </h2>
    {results.length === 0 ? (
      <p class="mt-4 flex max-w-prose items-center gap-2 rounded-lg border border-dashed border-line-strong bg-surface p-4 text-ink">
        <Icon name="circle-dashed" class="size-5 shrink-0" />
        Jeszcze bez wyniku
      </p>
    ) : (
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {resultsByAuthor.map(({ id, result }) =>
          result ? (
            <li class="rounded-lg border border-line bg-surface p-5">
              <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                <h3 class="text-xl font-semibold">{authorName(id)}</h3>
                <StatusBadge status={result.outcome} />
              </div>
              {(result.completedDate || result.time) && (
                <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-ink-muted">
                  {result.completedDate && (
                    <>
                      <dt class="font-semibold text-ink">
                        {result.outcome === 'finished'
                          ? 'Data'
                          : 'Data podejścia'}
                      </dt>
                      <dd>{formatDate(result.completedDate)}</dd>
                    </>
                  )}
                  {result.time && (
                    <>
                      <dt class="font-semibold text-ink">Czas</dt>
                      <dd>{result.time}</dd>
                    </>
                  )}
                </dl>
              )}
              {result.note && <p class="mt-2 text-ink-muted">{result.note}</p>}
              {result.resultsUrl && (
                <p class="mt-3">
                  <a href={result.resultsUrl} class="link" rel="noopener">
                    Wyniki oficjalne — {authorName(id)}
                  </a>
                </p>
              )}
            </li>
          ) : (
            <li class="rounded-lg border border-dashed border-line-strong bg-surface p-5">
              <h3 class="text-xl font-semibold">{authorName(id)}</h3>
              <p class="mt-2 flex items-center gap-2 text-ink">
                <Icon name="circle-dashed" class="size-5 shrink-0" />
                Jeszcze bez wyniku
              </p>
            </li>
          ),
        )}
      </ul>
    )}
  </section>

  <section class="mt-12" aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="text-2xl font-semibold">
      Powiązane wpisy
    </h2>
    {relatedPosts.length === 0 ? (
      <p class="mt-4 text-ink-muted">Brak wpisów o tym biegu.</p>
    ) : (
      <ul class="mt-4 space-y-4">
        {relatedPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="link text-lg font-semibold">
              {post.data.title}
            </a>
            <p class="text-sm text-ink-muted">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {' · '}
              {joinNames(post.data.authors.map((a) => authorName(a.id)))}
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
