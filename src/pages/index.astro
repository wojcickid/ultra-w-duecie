---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostTeaser from '../components/PostTeaser.astro';
import ProgressBar from '../components/ProgressBar.astro';
import RunFacts from '../components/RunFacts.astro';
import Section from '../components/Section.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Timeline from '../components/Timeline.astro';
import { getRunBadges } from '../lib/runs';
import {
  getNextRun,
  getTogetherSummary,
  sortRuns,
  splitCrownAndHistory,
} from '../lib/progress';

const [authorEntries, runEntries, postEntries] = await Promise.all([
  getCollection('authors'),
  getCollection('runs'),
  getCollection('posts'),
]);

const authors = [...authorEntries]
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((author) => ({ id: author.id, name: author.data.displayName }));
const authorIds = authors.map((author) => author.id);
const runs = sortRuns(runEntries);
const { crown, history } = splitCrownAndHistory(runs);

// Postęp duetu: licznik, jego skład i najbliższy start liczą się z danych przy budowie strony.
const summary = getTogetherSummary(runs, authorIds);
const progressLabel = `${summary.count} z ${summary.total} biegów ukończonych razem`;
const nextRun = getNextRun(runs, authorIds, new Date());

const latestPosts = [...postEntries]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Zdjęcie przy wstępie: to samo zdjęcie co we wpisie o Biegu Rzeźnika 2024,
// który zapoczątkował ten projekt (patrz akapit wstępu poniżej).
const heroPost = postEntries.find(
  (post) => post.id === 'bieg-rzeznika-2024-od-tego-wszystko-sie-zaczelo',
);
const heroImage = heroPost?.data.images?.[0];
---

<BaseLayout>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
    <div class="min-w-0">
      <h1 class="text-3xl font-bold sm:text-4xl">Ultra w duecie</h1>
      <p class="mt-4 max-w-prose text-lg text-ink-muted">
        Damian i Grzegorz wspólnie realizują Koronę Polskich Ultramaratonów 4.0
        — dziesięć biegów ultra, które chcą ukończyć obaj, razem. Pomysł zrodził
        się po wspólnym Biegu Rzeźnika w 2024 roku.
      </p>
    </div>
    {heroImage && (
      <Image
        src={heroImage.src}
        alt={heroImage.alt}
        width={192}
        height={192}
        densities={[1, 2]}
        class="aspect-square w-32 shrink-0 self-start rounded-lg object-cover sm:w-48"
      />
    )}
  </div>

  <Section id="progress" title="Postęp duetu">
    <div class="mt-4 rounded-lg border border-line bg-surface p-5">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span
          class="font-heading text-5xl font-bold text-brand-strong"
          aria-hidden="true"
        >
          {summary.count} / {summary.total}
        </span>
        <span class="text-xl font-semibold">{progressLabel}</span>
      </p>
      <div class="mt-4">
        <ProgressBar
          value={summary.count}
          max={summary.total}
          label={progressLabel}
        />
      </div>
      <p class="mt-4 max-w-prose">
        Liczą się tylko biegi ukończone przez nas obu tego samego dnia. Biegi,
        które ukończył tylko jeden z nas albo które ukończyliśmy w różnych
        dniach, oraz DNF i DNS pokazujemy osobno, poza licznikiem.
      </p>
      {summary.runs.length > 0 && (
        <div class="mt-3 text-ink-muted">
          <p>Skład licznika:</p>
          <ul class="mt-1 space-y-1">
            {summary.runs.map((run) => (
              <li>
                <a href={`/biegi/${run.id}`} class="link">
                  {run.data.name}
                </a>
                {run.data.retired &&
                  ' — wycofany z listy 10 biegów Korony 4.0, ale zaliczony wg regulaminu'}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </Section>

  <Section id="next-run" title="Najbliższy start">
    {nextRun && (
      <article
        data-next-run
        data-date={nextRun.isoDate}
        class="mt-4 rounded-lg border border-line bg-surface p-5"
      >
        <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
          <h3 class="min-w-0 text-xl font-semibold">
            <a href={`/biegi/${nextRun.run.id}`} class="link">
              {nextRun.run.data.name}
            </a>
          </h3>
          <div class="flex flex-wrap gap-2">
            {getRunBadges(nextRun.run.data).map((status) => (
              <StatusBadge status={status} />
            ))}
          </div>
        </div>
        <RunFacts run={nextRun.run.data} class="mt-3 text-ink-muted" />
        <p class="mt-3">
          <a
            href={`/biegi/${nextRun.run.id}`}
            class="link inline-flex min-h-11 items-center gap-2"
          >
            Szczegóły biegu
            <Icon name="arrow-right" />
          </a>
        </p>
      </article>
    )}
    <p
      id="next-run-empty"
      class="mt-4 text-ink-muted"
      hidden={Boolean(nextRun)}
    >
      Kolejny termin do ustalenia
    </p>
    {nextRun && <script is:inline>
      // Strona jest statyczna: po dniu startu (Europe/Warsaw) ukrywamy kartę i pokazujemy komunikat zastępczy.
      (() => {
        const card = document.querySelector('[data-next-run]');
        const empty = document.getElementById('next-run-empty');
        const start = card?.getAttribute('data-date');
        if (!card || !empty || !start) return;
        const today = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Europe/Warsaw',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(new Date());
        if (today > start) {
          card.hidden = true;
          empty.hidden = false;
        }
      })();
    </script>}
  </Section>

  <Section id="journey" title="Nasza droga">
    {runs.length === 0 ? (
      <p class="mt-4 text-ink-muted">Lista biegów pojawi się wkrótce.</p>
    ) : (
      <>
        <h3 class="mt-6 text-xl font-semibold">Korona 4.0 — 10 biegów</h3>
        <Timeline runs={crown} authors={authors} />

        {history.length > 0 && (
          <section aria-labelledby="history-heading" class="mt-10">
            <h3 id="history-heading" class="text-xl font-semibold">
              Historia projektu
            </h3>
            <p class="mt-2 max-w-prose text-ink-muted">
              Biegi spoza listy 10 biegów Korony 4.0. Ukończone wspólnie
              zaliczają się do naszego postępu wg regulaminu Korony.
            </p>
            <Timeline runs={history} authors={authors} />
          </section>
        )}
      </>
    )}
    <p class="mt-6 flex flex-wrap gap-x-6">
      <a href="/biegi" class="link inline-flex min-h-11 items-center gap-2">
        Wszystkie biegi
        <Icon name="arrow-right" />
      </a>
      <a href="/wyniki" class="link inline-flex min-h-11 items-center gap-2">
        Wyniki indywidualne
        <Icon name="arrow-right" />
      </a>
    </p>
  </Section>

  <Section id="posts" title="Ostatnie wpisy">
    {latestPosts.length === 0 ? (
      <p class="mt-4 text-ink-muted">Wpisy pojawią się wkrótce.</p>
    ) : (
      <ul class="mt-4 divide-y divide-line rounded-lg border border-line bg-surface">
        {latestPosts.map((post) => (
          <li class="p-4">
            <PostTeaser post={post} headingLevel={3} />
          </li>
        ))}
      </ul>
    )}
    <p class="mt-6">
      <a href="/blog" class="link inline-flex min-h-11 items-center gap-2">
        Wszystkie wpisy
        <Icon name="arrow-right" />
      </a>
    </p>
  </Section>
</BaseLayout>
