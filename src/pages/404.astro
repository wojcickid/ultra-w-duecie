---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Nie znaleziono strony — Ultra w duecie" noindex>
  <div class="max-w-prose">
    <p class="font-semibold text-accent">Błąd 404</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Nie ma takiej strony</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Ten adres nie istnieje albo strona została przeniesiona. Wróć na start i
      wyruszmy jeszcze raz.
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">
        Wróć na start
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a href="/biegi" class="btn btn-secondary">
        Zobacz biegi
      </a>
    </p>
  </div>
</BaseLayout>
