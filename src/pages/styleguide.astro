---
/**
 * Strona pomocnicza do akceptacji kierunku wizualnego (TASK-004).
 * DO USUNIĘCIA lub ukrycia przed publikacją. Ma <meta name="robots" content="noindex">.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import type { ResultOutcome, RunStatus } from '../components/StatusBadge.astro';

const colorGroups = [
  {
    name: 'Tło i powierzchnie',
    items: [
      { token: 'paper', cls: 'bg-paper', hex: '#f7f5ef' },
      { token: 'surface', cls: 'bg-surface', hex: '#ffffff' },
      { token: 'sand', cls: 'bg-sand', hex: '#ece8db' },
    ],
  },
  {
    name: 'Tekst',
    items: [
      { token: 'ink', cls: 'bg-ink', hex: '#1c2620' },
      { token: 'ink-muted', cls: 'bg-ink-muted', hex: '#4b5850' },
    ],
  },
  {
    name: 'Marka i akcent',
    items: [
      { token: 'brand', cls: 'bg-brand', hex: '#2d5a3d' },
      { token: 'brand-strong', cls: 'bg-brand-strong', hex: '#1f4230' },
      { token: 'accent', cls: 'bg-accent', hex: '#a4491b' },
    ],
  },
  {
    name: 'Linie i fokus',
    items: [
      { token: 'line', cls: 'bg-line', hex: '#d9d5c7' },
      { token: 'line-strong', cls: 'bg-line-strong', hex: '#7b837a' },
      { token: 'focus', cls: 'bg-focus', hex: '#0b5cad' },
    ],
  },
];

const statuses: RunStatus[] = [
  'completed',
  'planned',
  'unplanned',
  'withdrawn',
];
const outcomes: ResultOutcome[] = ['finished', 'dnf', 'dns'];
const radii = [
  { name: 'sm', cls: 'rounded-sm', value: '0.25rem' },
  { name: 'md', cls: 'rounded-md', value: '0.5rem' },
  { name: 'lg', cls: 'rounded-lg', value: '0.875rem' },
  { name: 'pill', cls: 'rounded-pill', value: '9999px' },
];
---

<BaseLayout title="Styleguide — Ultra w duecie" noindex>
  <p class="rounded-md border border-status-planned-fg bg-status-planned-bg px-4 py-3 text-status-planned-fg">
    <strong>Strona pomocnicza (TASK-004).</strong> Służy do akceptacji kierunku
    wizualnego. Do usunięcia lub ukrycia przed publikacją (ma{' '}
    <code>noindex</code>).
  </p>

  <h1 class="mt-8 text-4xl font-bold">Styleguide</h1>
  <p class="mt-2 max-w-prose text-lg text-ink-muted">
    Paleta, typografia, przyciski, znaczniki statusu i karty — wszystko na
    tokenach z <code>src/styles/global.css</code>.
  </p>

  <section class="mt-12" aria-labelledby="sg-colors">
    <h2 id="sg-colors" class="text-2xl font-bold">
      Paleta
    </h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      {colorGroups.map((group) => (
        <div>
          <h3 class="text-base font-semibold">{group.name}</h3>
          <ul class="mt-2 space-y-2">
            {group.items.map((item) => (
              <li class="flex items-center gap-3">
                <span
                  class={`size-10 shrink-0 rounded-md border border-line ${item.cls}`}
                />
                <span>
                  <code class="font-semibold">{item.token}</code>
                  <span class="block text-sm text-ink-muted">{item.hex}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="sg-type">
    <h2 id="sg-type" class="text-2xl font-bold">
      Typografia
    </h2>
    <p class="mt-2 text-sm text-ink-muted">
      Nagłówki: <code>font-heading</code> (systemowy serif Charter/Cambria).
      Tekst: <code>font-sans</code> (system-ui). Bez zewnętrznych czcionek.
    </p>
    <div class="mt-4 space-y-4">
      <h1 class="text-4xl font-bold">Nagłówek 1 — Korona w duecie</h1>
      <h2 class="text-3xl font-bold">Nagłówek 2 — Bieg Rzeźnika</h2>
      <h3 class="text-2xl font-semibold">Nagłówek 3 — Etap i trasa</h3>
      <h4 class="text-xl font-semibold">Nagłówek 4 — Zaopatrzenie</h4>
      <p class="max-w-prose">
        Tekst podstawowy. Zawodnicy startują o świcie, a trasa prowadzi przez
        granie i doliny. Zażółć gęślą jaźń — polskie znaki: ąćęłńóśźż ĄĆĘŁŃÓŚŹŻ.
      </p>
      <p class="max-w-prose text-ink-muted">
        Tekst drugorzędny (ink-muted), np. daty, opisy, podpisy.
      </p>
      <p class="max-w-prose text-sm text-ink-muted">
        Tekst mały (text-sm) — metadane i etykiety.
      </p>
      <p>
        Link w treści:{' '}
        <a href="#sg-type" class="link">
          przykładowy link
        </a>{' '}
        oraz{' '}
        <a href="#sg-colors" class="link">
          drugi
        </a>
        .
      </p>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="sg-buttons">
    <h2 id="sg-buttons" class="text-2xl font-bold">
      Przyciski i linki
    </h2>
    <p class="mt-4 flex flex-wrap gap-3">
      <a href="#sg-buttons" class="btn btn-primary">
        Główny
        <Icon name="arrow-right" />
      </a>
      <a href="#sg-buttons" class="btn btn-secondary">
        Drugorzędny
      </a>
    </p>
    <p class="mt-3 text-sm text-ink-muted">
      Wciśnij Tab, aby zobaczyć widoczny fokus (obrys 3 px, kolor{' '}
      <code>focus</code>) oraz link „Przejdź do treści”.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="sg-status">
    <h2 id="sg-status" class="text-2xl font-bold">
      Znacznik statusu
    </h2>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">
      Każdy status ma etykietę tekstową i osobną ikonę; kolor tylko je wzmacnia
      (WCAG 1.4.1).
    </p>
    <ul class="mt-4 flex flex-wrap gap-3">
      {statuses.map((status) => (
        <li>
          <StatusBadge status={status} />
        </li>
      ))}
    </ul>
    <h3 class="mt-6 text-base font-semibold">Wynik osoby (outcome)</h3>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">
      Znaczniki wyniku jednej osoby w biegu: ukończył, nie ukończył (DNF), nie
      wystartował (DNS).
    </p>
    <ul class="mt-3 flex flex-wrap gap-3">
      {outcomes.map((outcome) => (
        <li>
          <StatusBadge status={outcome} />
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="sg-cards">
    <h2 id="sg-cards" class="text-2xl font-bold">
      Karta
    </h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <Card title="Bieg Rzeźnika" href="#sg-cards">
        <p class="flex items-center gap-2">
          <StatusBadge status="completed" />
        </p>
        <p class="mt-2">
          Karta klikalna: cały obszar jest linkiem (najedź myszą lub użyj Tab).
        </p>
      </Card>
      <Card title="Supermaraton Gór Stołowych">
        <p class="flex items-center gap-2">
          <StatusBadge status="planned" />
        </p>
        <p class="mt-2">Karta statyczna, bez linku — tylko treść.</p>
      </Card>
      <Card title="Bieg 7 Dolin" headingLevel={3}>
        <p class="flex items-center gap-2">
          <StatusBadge status="withdrawn" />
        </p>
        <p class="mt-2">
          Bieg wycofany z listy Korony; ukończenie zostaje w statystykach.
        </p>
      </Card>
      <Card>
        <p>Karta bez tytułu.</p>
      </Card>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="sg-radii">
    <h2 id="sg-radii" class="text-2xl font-bold">
      Promienie i odstępy
    </h2>
    <ul class="mt-4 flex flex-wrap gap-4">
      {radii.map((radius) => (
        <li class="text-center text-sm">
          <span
            class={`block size-16 border-2 border-brand bg-sand ${radius.cls}`}
          />
          <code>{radius.name}</code>
          <span class="block text-ink-muted">{radius.value}</span>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-ink-muted">
      Odstępy: skala Tailwinda (<code>1 = 0,25 rem</code>); kontener treści{' '}
      <code>max-w-5xl</code>, marginesy boczne 16 px (od <code>sm</code> 24 px).
    </p>
  </section>
</BaseLayout>
